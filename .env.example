# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Required ---
# Free key from Google AI Studio (https://aistudio.google.com/apikey).
# Serves Gemma 4 for both image vision and message routing.
GEMINI_API_KEY=

# --- Optional (sensible defaults; documented in docs/ARCHITECTURE.md) ---
# MEDIA_VISION_MODEL=gemma-4-31b-it   # vision model for images
# MEDIA_WHISPER_SIZE=base             # faster-whisper size: base | small | medium
# ROUTING_MODEL=gemma-4-31b-it        # routing model
# ROUTING_WORKERS=6                   # routing concurrency (3–4 on free tier)
# EVIDENCE_TOPK=1                     # evidence precision/recall knob (1 = highest precision)
# OUTPUT_PATH=                        # override the write target (default: results/output.csv)

# --- Optional: only if MEDIA_VISION_PROVIDER=anthropic ---
# ANTHROPIC_API_KEY=
